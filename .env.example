# Copy this file to .env.local and fill in real values. See /docs/DEPLOYMENT.md
# for the full setup walkthrough. .env.local is git-ignored; this file is not
# (it contains no secrets, only variable names).

# --- Supabase (required for Live Mode) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only -- NEVER prefix with NEXT_PUBLIC_, never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n (required to submit real leads from the frontend) -------------
NEXT_PUBLIC_N8N_LEAD_WEBHOOK_URL=

# Optional. When set, Live Mode "Log call" posts inbound/outbound calls to n8n
# "CORE -- Call Intake" instead of writing them directly.
# NEXT_PUBLIC_N8N_CALL_WEBHOOK_URL=

# Live Mode "Call back" on a call dials the patient through n8n
# "ElevenLabs — Outbound Call".
# NEXT_PUBLIC_N8N_OUTBOUND_WEBHOOK_URL=

# Server-only. Knowledge Base upload and search call these n8n production
# webhooks. Do not prefix them with NEXT_PUBLIC_.
# N8N_KNOWLEDGE_INDEX_WEBHOOK_URL=
# N8N_KNOWLEDGE_SEARCH_WEBHOOK_URL=

# --- Optional ------------------------------------------------------------
# Pins the deployment to Supabase-only and disables the Demo/Live toggle.
# NEXT_PUBLIC_DATA_SOURCE=supabase

# Shared secret for the n8n -> app callback route (POST /api/events).
# DENTALFLOW_WEBHOOK_SECRET=

# Convenience default org id for local testing/scripts.
# NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=
