    {
      "id": "build_rows",
      "name": "Build Chunk Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        -220
      ],
      "parameters": {
        "jsCode": "const doc = $('Chunk Text').first().json;\nconst chunks = doc.chunks || [];\nconst vectors = Array.isArray($json.data) ? $json.data : null;\nif (!vectors || vectors.length !== chunks.length) {\n  const message = ($json.error && $json.error.message) || 'The embedding service did not return one vector per passage.';\n  return [{ json: { _ok: false, _error: message } }];\n}\nconst rows = [];\nfor (let index = 0; index < chunks.length; index++) {\n  const vector = vectors.find((item) => item.index === index) || vectors[index];\n  if (!vector || !Array.isArray(vector.embedding) || vector.embedding.length !== 1536) {\n    return [{ json: { _ok: false, _error: 'The embedding service returned a vector of the wrong size.' } }];\n  }\n  rows.push({\n    organization_id: doc.organization_id,\n    document_id: doc.id,\n    content: chunks[index],\n    chunk_index: index,\n    embedding: '[' + vector.embedding.join(',') + ']'\n  });\n}\nreturn [{ json: { _ok: true, rows, chunk_count: rows.length } }];"
      }
