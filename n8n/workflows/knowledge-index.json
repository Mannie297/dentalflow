        140,
        -120
      ],
      "parameters": {
        "jsCode": "const doc = $('Load Document').first().json;\nreturn [{ json: { id: doc.id, organization_id: doc.organization_id, file_type: doc.file_type, storage_path: doc.storage_path }, binary: $input.first().binary }];"
