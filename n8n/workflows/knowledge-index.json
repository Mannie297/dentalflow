    {
      "id": "chunk_text",
      "name": "Chunk Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        -120
      ],
      "parameters": {
        "jsCode": "// Keep this in step with src/lib/knowledge/chunk-text.ts.\nfunction chunkText(input) {\n  const size = 700;\n  const overlap = 80;\n  const maxChunks = 120;\n  const text = String(input || '').replace(/\\r\\n/g, '\\n').replace(/[ \\t]+\\n/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n  if (!text) return [];\n  const chunks = [];\n  let start = 0;\n  while (start < text.length && chunks.length < maxChunks) {\n    let end = Math.min(text.length, start + size);\n    if (end < text.length) {\n      const lineBreak = text.lastIndexOf('\\n', end);\n      const space = text.lastIndexOf(' ', end);\n      const breakAt = lineBreak > start + size * 0.5 ? lineBreak : space;\n      if (breakAt > start + size * 0.5) end = breakAt;\n    }\n    const piece = text.slice(start, end).trim();\n    if (piece) chunks.push(piece);\n    if (end >= text.length) break;\n    start = Math.max(end - overlap, start + 1);\n  }\n  return chunks;\n}\n\nconst source = $input.first().json;\nconst base = { id: source.id, organization_id: source.organization_id };\nif (source._read_error) {\n  return [{ json: { ...base, chunks: [], _has_chunks: false, _error: source._read_error } }];\n}\nconst chunks = chunkText(source.text);\nif (!chunks.length) {\n  return [{ json: { ...base, chunks, _has_chunks: false, _error: 'No text could be read from this file.' } }];\n}\nreturn [{ json: { ...base, chunks, _has_chunks: true } }];"
      }
