    {
      "id": "read_file_text",
      "name": "Read File Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        -120
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst doc = { id: item.json.id, organization_id: item.json.organization_id, file_type: item.json.file_type };\n\nfunction extractDocx(buffer) {\n  let inflateRawSync;\n  try {\n    inflateRawSync = require('zlib').inflateRawSync;\n  } catch (error) {\n    throw new Error('n8n could not read this Word file. Upload a PDF or text file instead.');\n  }\n  const data = Buffer.isBuffer(buffer) ? buffer : Buffer.from(buffer);\n  const eocd = data.lastIndexOf(Buffer.from([0x50, 0x4b, 0x05, 0x06]));\n  if (eocd < 0) throw new Error('This Word file could not be opened.');\n  const count = data.readUInt16LE(eocd + 10);\n  let cursor = data.readUInt32LE(eocd + 16);\n  for (let i = 0; i < count; i++) {\n    if (cursor + 46 > data.length || data.readUInt32LE(cursor) !== 0x02014b50) break;\n    const method = data.readUInt16LE(cursor + 10);\n    const compSize = data.readUInt32LE(cursor + 20);\n    const nameLen = data.readUInt16LE(cursor + 28);\n    const extraLen = data.readUInt16LE(cursor + 30);\n    const commentLen = data.readUInt16LE(cursor + 32);\n    const localOffset = data.readUInt32LE(cursor + 42);\n    const name = data.slice(cursor + 46, cursor + 46 + nameLen).toString('utf8');\n    cursor += 46 + nameLen + extraLen + commentLen;\n    if (name !== 'word/document.xml') continue;\n    const localNameLen = data.readUInt16LE(localOffset + 26);\n    const localExtraLen = data.readUInt16LE(localOffset + 28);\n    const start = localOffset + 30 + localNameLen + localExtraLen;\n    const compressed = data.slice(start, start + compSize);\n    const xml = method === 0 ? compressed.toString('utf8') : inflateRawSync(compressed).toString('utf8');\n    return xml\n      .replace(/<w:tab\\/>/g, '\\t')\n      .replace(/<w:br\\/>/g, '\\n')\n      .replace(/<\\/w:p>/g, '\\n')\n      .replace(/<[^>]+>/g, '')\n      .replace(/&amp;/g, '&')\n      .replace(/&lt;/g, '<')\n      .replace(/&gt;/g, '>')\n      .replace(/&quot;/g, '\"')\n      .replace(/&#39;|&apos;/g, \"'\")\n      .trim();\n  }\n  throw new Error('This Word file has no readable text.');\n}\n\nif (doc.file_type === 'pdf') {\n  return [{ json: { ...doc, _needsPdf: true }, binary: item.binary }];\n}\n\ntry {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const text = doc.file_type === 'docx' ? extractDocx(buf) : buf.toString('utf8');\n  return [{ json: { ...doc, text, _needsPdf: false } }];\n} catch (error) {\n  return [{ json: { ...doc, text: '', _needsPdf: false, _read_error: error.message } }];\n}"
      }
    },
