        "jsCode": "const body = $json.body ?? $json;\nconst row = Array.isArray(body) ? body[0] : null;\nif (!row || !row.id || !row.storage_path) {\n  return [{ json: { _found: false, _error: 'Document was not found.' } }];\n}\nif (!['pdf', 'docx', 'txt', 'csv'].includes(row.file_type)) {\n  return [{ json: { _found: false, _error: 'This file type cannot be indexed.' } }];\n}\nreturn [{ json: { ...row, _found: true } }];"
