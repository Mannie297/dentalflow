      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        -240
      ],
      "parameters": {
        "jsCode": "const doc = $('Read File Text').first().json;\nconst text = String($json.text ?? $json.data ?? $json.content ?? '').trim();\nreturn [{ json: { id: doc.id, organization_id: doc.organization_id, text, _read_error: text ? undefined : 'No text could be read from this PDF.' } }];"
      }
