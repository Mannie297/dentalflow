      "parameters": {
        "jsCode": "const body = $json.body ?? [];\nconst matches = Array.isArray(body) ? body : [];\nconst normalized = $('Validate & Normalize').item.json;\nreturn [{ json: { ...normalized, patient_id: matches[0]?.id ?? null, found: Boolean(matches[0]) } }];"
