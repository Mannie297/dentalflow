      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{ encodeURIComponent($json.calendar_id) }}/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ summary: $json.calendar_summary, description: $json.calendar_description, start: { dateTime: $json.starts_at }, end: { dateTime: $json.ends_at } }) }}",
        "options": {
          "response": { "response": { "fullResponse": true, "neverError": true } }
