    {
      "id": "read_calendar_response",
      "name": "Read Calendar Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, -230],
      "parameters": {
        "jsCode": "let prior;\ntry { prior = $('Use Existing Patient').item.json; } catch (e) { prior = $('Use New Patient').item.json; }\n\nconst res = $json;\nlet payload = res.body !== undefined ? res.body : res;\nif (typeof payload === 'string') {\n  try { payload = JSON.parse(payload); } catch (e) { payload = { message: payload }; }\n}\nconst status = Number(res.statusCode || res.status || 0);\nconst ok = status >= 200 && status < 300 && payload && typeof payload.id === 'string';\nconst apiError = payload && payload.error && payload.error.message;\nconst errorMessage = ok ? null : (apiError || `Google Calendar did not create the event (HTTP ${status}). Check the CALENDAR_ID and the Google Calendar account credential.`);\n\nreturn [{\n  json: {\n    ...prior,\n    _calendar_ok: ok,\n    _calendar_error: errorMessage,\n    calendar_event_id: ok ? payload.id : null\n  }\n}];"
      }
    },
