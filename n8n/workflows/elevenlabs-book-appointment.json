{
  "name": "ElevenLabs — Book Appointment",
  "meta": {
    "description": "Books an appointment: checks the dentist's schedule for a conflict, finds or creates the patient, creates the Google Calendar event, writes the appointment row, and logs appointment.confirmed. Called directly by the ElevenLabs voice agent's booking tool, and by DentalFlow's own Book Appointment dialog when NEXT_PUBLIC_N8N_BOOK_APPOINTMENT_WEBHOOK_URL is set. See /docs/N8N_WORKFLOWS.md."
  },
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook: Book Appointment",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 0],
      "parameters": {
        "path": "book-appointment",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1380, 0],
      "parameters": {
        "jsCode": "const ORG = '11111111-1111-1111-1111-111111111111';\nconst CALENDAR_ID = '';\n\nconst SERVICE_LABELS = {\n  general_cleaning: 'General Cleaning',\n  emergency_dental: 'Emergency Dental',\n  dental_exam: 'Dental Exam',\n  implants: 'Dental Implants',\n  invisalign: 'Invisalign',\n  whitening: 'Whitening',\n  crowns: 'Crowns',\n  root_canal: 'Root Canal',\n  childrens_dentistry: \"Children's Dentistry\",\n  other: 'Other'\n};\nconst DEFAULT_DURATION_MINUTES = {\n  general_cleaning: 30, emergency_dental: 30, dental_exam: 30, implants: 60,\n  invisalign: 45, whitening: 45, crowns: 60, root_canal: 60, childrens_dentistry: 30, other: 30\n};\n\nfunction normalizePhone(raw) {\n  const trimmed = String(raw || '').trim();\n  const hasPlus = trimmed.startsWith('+');\n  const digits = trimmed.replace(/[^0-9]/g, '');\n  return hasPlus ? `+${digits}` : digits;\n}\nfunction capitalize(v) {\n  return String(v || '').trim().split(/\\s+/).filter(Boolean)\n    .map((w) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');\n}\n\nconst b = $input.first().json.body ?? $input.first().json;\nconst errors = [];\n\nconst organizationId = String(b.organization_id || ORG).trim();\nconst calendarId = String(b.calendar_id || CALENDAR_ID).trim();\nconst patientName = capitalize(b.patient_name);\nconst phone = normalizePhone(b.phone);\nconst service = String(b.service || '').trim();\nconst dentistName = String(b.dentist_name || '').trim();\nconst startsAtDate = b.starts_at ? new Date(b.starts_at) : null;\n\nif (!patientName) errors.push('patient_name is required.');\nif (phone.replace(/[^0-9]/g, '').length < 7) errors.push('phone must include at least 7 digits.');\nif (!service || !(service in SERVICE_LABELS)) errors.push(`service must be one of: ${Object.keys(SERVICE_LABELS).join(', ')}.`);\nif (!dentistName) errors.push('dentist_name is required.');\nif (!startsAtDate || Number.isNaN(startsAtDate.getTime())) errors.push('starts_at must be a valid ISO date-time.');\nif (!calendarId) errors.push('Set CALENDAR_ID in Validate & Normalize, or send calendar_id.');\n\nconst durationMinutes = Number(b.duration_minutes) > 0 ? Number(b.duration_minutes) : (DEFAULT_DURATION_MINUTES[service] || 30);\nconst startsAt = startsAtDate && !Number.isNaN(startsAtDate.getTime()) ? startsAtDate : null;\nconst endsAt = b.ends_at ? new Date(b.ends_at) : (startsAt ? new Date(startsAt.getTime() + durationMinutes * 60000) : null);\nif (startsAt && endsAt && endsAt.getTime() <= startsAt.getTime()) errors.push('ends_at must be after starts_at.');\n\nconst serviceLabel = SERVICE_LABELS[service] || service;\nconst notes = b.notes ? String(b.notes).trim() : null;\nconst nameParts = patientName.split(/\\s+/);\n\nreturn [{\n  json: {\n    _valid: errors.length === 0,\n    _errors: errors,\n    organization_id: organizationId,\n    calendar_id: calendarId,\n    patient_name: patientName,\n    first_name: nameParts[0] || patientName,\n    last_name: nameParts.slice(1).join(' '),\n    phone,\n    service,\n    service_label: serviceLabel,\n    dentist_name: dentistName,\n    starts_at: startsAt ? startsAt.toISOString() : null,\n    ends_at: endsAt ? endsAt.toISOString() : null,\n    estimated_value: Number(b.estimated_value) || 0,\n    notes,\n    source: b.source || null,\n    lead_id: b.lead_id || null,\n    patient_id: b.patient_id || null,\n    call_id: b.call_id || null,\n    calendar_summary: `${serviceLabel} — ${patientName}`,\n    calendar_description: `Phone: ${phone}${notes ? `\\nNotes: ${notes}` : ''}\\nBooked via DentalFlow AI Receptionist.`\n  }\n}];"
      }
    },
