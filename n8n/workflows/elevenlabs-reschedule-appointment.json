      "parameters": {
        "jsCode": "const prior = $('Prepare Move').item.json;\nconst res = $json;\nlet payload = res.body !== undefined ? res.body : res;\nif (typeof payload === 'string') {\n  try { payload = JSON.parse(payload); } catch (e) { payload = { message: payload }; }\n}\nconst status = Number(res.statusCode || res.status || 0);\nconst ok = status >= 200 && status < 300 && payload && typeof payload.id === 'string';\nconst apiError = payload && payload.error && payload.error.message;\nconst errorMessage = ok ? null : (apiError || `Google Calendar did not update the event (HTTP ${status}). Check the CALENDAR_ID and the Google Calendar account credential.`);\nreturn [{\n  json: {\n    ...prior,\n    _calendar_ok: ok,\n    _calendar_error: errorMessage,\n    calendar_event_id: ok ? payload.id : (prior.appointment.calendar_event_id || null)\n  }\n}];"
