        "jsCode": "function clinicDate(iso) {\n  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date(iso));\n  const get = (type) => parts.find((part) => part.type === type)?.value ?? '';\n  return `${get('year')}-${get('month')}-${get('day')}`;\n}\nconst body = $json.body ?? [];\nconst matches = Array.isArray(body) ? body : [];\nconst prior = $('Validate & Normalize').item.json;\nconst upcoming = matches.filter((row) => ['requested', 'confirmed'].includes(row.status) && new Date(row.starts_at).getTime() >= Date.now());\nlet chosen = null;\nif (prior.appointment_id) chosen = upcoming[0] ?? null;\nelse if (prior.date) chosen = upcoming.find((row) => clinicDate(row.starts_at) === prior.date) ?? null;\nelse chosen = upcoming[0] ?? null;\nreturn [{ json: { ...prior, found: Boolean(chosen), appointment: chosen } }];"
