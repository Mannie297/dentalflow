        "jsCode": "const ORG = '11111111-1111-1111-1111-111111111111';\nconst CALENDAR_ID = '';\nconst DENTISTS = ['Dr. Sarah Chen', 'Dr. Amrit Bhandal', 'Dr. Michael Wong'];\n\nfunction normalizePhone(raw) {\n  const digits = String(raw || '').replace(/[^0-9]/g, '');\n  if (digits.length === 10) return `+1${digits}`;\n  if (digits.length === 11 && digits.startsWith('1')) return `+${digits}`;\n  if (String(raw || '').trim().startsWith('+') && digits) return `+${digits}`;\n  return digits;\n}\n\nconst b = $input.first().json.body ?? $input.first().json;\nconst errors = [];\n\nconst organizationId = String(b.organization_id || ORG).trim();\nconst calendarId = String(b.calendar_id || CALENDAR_ID).trim();\nconst appointmentId = b.appointment_id ? String(b.appointment_id).trim() : '';\nconst phone = normalizePhone(b.phone);\nconst phoneDigits = phone.replace(/[^0-9]/g, '');\nconst phoneLike = phoneDigits.length >= 7 ? phoneDigits.slice(-10) : '';\nconst date = b.date ? String(b.date).trim().slice(0, 10) : null;\nconst dentistName = b.dentist_name ? String(b.dentist_name).trim() : '';\nconst startsAtDate = b.starts_at ? new Date(b.starts_at) : null;\n\nif (!appointmentId && phoneDigits.length < 7) {\n  errors.push('Either appointment_id, or a phone number with at least 7 digits, is required.');\n}\nif (!startsAtDate || Number.isNaN(startsAtDate.getTime())) errors.push('starts_at must be a valid ISO date-time.');\nif (dentistName && !DENTISTS.includes(dentistName)) {\n  errors.push('dentist_name must be Dr. Sarah Chen, Dr. Amrit Bhandal, or Dr. Michael Wong.');\n}\nif (!calendarId) errors.push('Set CALENDAR_ID in Validate & Normalize, or send calendar_id.');\n\nreturn [{\n  json: {\n    _valid: errors.length === 0,\n    _errors: errors,\n    organization_id: organizationId,\n    calendar_id: calendarId,\n    appointment_id: appointmentId,\n    phone,\n    phone_like: phoneLike,\n    date,\n    dentist_name: dentistName,\n    starts_at: startsAtDate && !Number.isNaN(startsAtDate.getTime()) ? startsAtDate.toISOString() : null\n  }\n}];"
