      "parameters": {
        "jsCode": "function torontoParts(date) {\n  const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Toronto', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(date);\n  const get = (type) => parts.find((part) => part.type === type)?.value ?? '';\n  return { weekday: get('weekday'), minutes: Number(get('hour')) * 60 + Number(get('minute')) };\n}\nfunction withinHours(start, end) {\n  const open = { Mon: [480, 1080], Tue: [480, 1080], Wed: [480, 1080], Thu: [480, 1080], Fri: [480, 1020], Sat: [540, 780] };\n  const s = torontoParts(start);\n  const e = torontoParts(end);\n  const window = open[s.weekday];\n  if (!window || s.weekday !== e.weekday) return false;\n  return s.minutes >= window[0] && e.minutes <= window[1] && e.minutes > s.minutes;\n}\nconst SERVICE_LABELS = {\n  general_cleaning: 'General Cleaning', emergency_dental: 'Emergency Dental', dental_exam: 'Dental Exam',\n  implants: 'Dental Implants', invisalign: 'Invisalign', whitening: 'Whitening', crowns: 'Crowns',\n  root_canal: 'Root Canal', childrens_dentistry: \"Children's Dentistry\", other: 'Other'\n};\n\nconst prior = $('Resolve Appointment').item.json;\nconst appointment = prior.appointment;\nconst newStart = new Date(prior.starts_at);\nconst oldStart = new Date(appointment.starts_at);\nconst oldEnd = new Date(appointment.ends_at);\nconst durationMs = oldEnd.getTime() > oldStart.getTime() ? oldEnd.getTime() - oldStart.getTime() : 30 * 60000;\nconst newEnd = new Date(newStart.getTime() + durationMs);\nconst dentistName = prior.dentist_name || appointment.dentist_name;\nlet error = null;\nif (Number.isNaN(newStart.getTime())) error = 'starts_at must be a valid ISO date-time.';\nelse if (newStart.getTime() <= Date.now()) error = 'The new time must be in the future.';\nelse if (!withinHours(newStart, newEnd)) error = 'That time is outside clinic hours. Offer a time from Monday to Thursday 8am to 6pm, Friday 8am to 5pm, or Saturday 9am to 1pm.';\nelse if (newStart.getTime() === oldStart.getTime() && dentistName === appointment.dentist_name) error = 'That visit is already at that time.';\n\nconst serviceLabel = SERVICE_LABELS[appointment.service] || appointment.service || 'Appointment';\nreturn [{\n  json: {\n    ...prior,\n    dentist_name: dentistName,\n    new_starts_at: Number.isNaN(newStart.getTime()) ? null : newStart.toISOString(),\n    new_ends_at: Number.isNaN(newEnd.getTime()) ? null : newEnd.toISOString(),\n    _ready: !error,\n    _move_error: error,\n    calendar_summary: `${serviceLabel} — ${appointment.patient_name}`,\n    calendar_description: `Phone: ${prior.phone || ''}\\nRescheduled via DentalFlow AI Receptionist.`\n  }\n}];"
