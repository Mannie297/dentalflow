        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Prefer", "value": "return=representation" }] },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "organization_id", "value": "={{ $json.body[0].organization_id }}" },
            { "name": "event_type", "value": "appointment.cancelled" },
            { "name": "entity_type", "value": "appointment" },
            { "name": "entity_id", "value": "={{ $json.body[0].id }}" },
            { "name": "payload", "value": "={{ { patient_name: $json.body[0].patient_name, dentist_name: $json.body[0].dentist_name, starts_at: $json.body[0].starts_at } }}" },
            { "name": "status", "value": "completed" }
          ]
        },
        "options": { "response": { "response": { "fullResponse": true } } }
      },
      "credentials": { "supabaseApi": { "id": "supabase-account", "name": "Supabase account" } }
    },
    {
      "id": "respond_success",
      "name": "Respond: Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1480, -60],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, appointment: $('Update Appointment Status').item.json.body[0], message: 'Appointment cancelled.' } }}",
        "options": { "responseCode": 200 }
      }
    }
