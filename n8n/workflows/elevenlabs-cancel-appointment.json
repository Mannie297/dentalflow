{
  "name": "ElevenLabs — Cancel Appointment",
  "meta": {
    "description": "Cancels an appointment, found either by appointment_id or by the patient's phone number (picking the soonest upcoming visit, or the one on a given date). Deletes the matching Google Calendar event when one exists, marks the appointment cancelled, and logs appointment.cancelled. Called directly by the ElevenLabs voice agent's cancellation tool, and by DentalFlow's own Appointments page when NEXT_PUBLIC_N8N_CANCEL_APPOINTMENT_WEBHOOK_URL is set. See /docs/N8N_WORKFLOWS.md."
  },
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook: Cancel Appointment",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 0],
      "parameters": {
        "path": "cancel-appointment",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1380, 0],
      "parameters": {
        "jsCode": "const ORG = '11111111-1111-1111-1111-111111111111';\nconst CALENDAR_ID = '';\n\nfunction normalizePhone(raw) {\n  if (!raw) return '';\n  const trimmed = String(raw).trim();\n  const hasPlus = trimmed.startsWith('+');\n  const digits = trimmed.replace(/[^0-9]/g, '');\n  return hasPlus ? `+${digits}` : digits;\n}\n\nconst b = $input.first().json.body ?? $input.first().json;\nconst errors = [];\n\nconst organizationId = String(b.organization_id || ORG).trim();\nconst calendarId = String(b.calendar_id || CALENDAR_ID).trim();\nconst appointmentId = b.appointment_id ? String(b.appointment_id).trim() : '';\nconst phone = normalizePhone(b.phone);\nconst date = b.date ? String(b.date).trim().slice(0, 10) : null;\n\nif (!appointmentId && phone.replace(/[^0-9]/g, '').length < 7) {\n  errors.push('Either appointment_id, or a phone number with at least 7 digits, is required.');\n}\nif (!calendarId) errors.push('Set CALENDAR_ID in Validate & Normalize, or send calendar_id.');\n\nreturn [{\n  json: {\n    _valid: errors.length === 0,\n    _errors: errors,\n    organization_id: organizationId,\n    calendar_id: calendarId,\n    appointment_id: appointmentId,\n    phone,\n    date\n  }\n}];"
      }
    },
    {
      "id": "validation_passed",
      "name": "Validation Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1160, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json._valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "respond_invalid",
      "name": "Respond: Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [-940, 260],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: $json._errors.join(' ') } }}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "has_appointment_id",
      "name": "Has Appointment Id?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-940, -60],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ Boolean($json.appointment_id) }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
