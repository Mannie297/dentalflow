      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-720, -220],
      "parameters": {
        "method": "GET",
        "url": "https://lngkdzbhhxlnxweottie.supabase.co/rest/v1/appointments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $json.appointment_id }}" },
            { "name": "organization_id", "value": "=eq.{{ $json.organization_id }}" },
            { "name": "select", "value": "*" },
            { "name": "limit", "value": "1" }
          ]
        },
        "options": { "response": { "response": { "fullResponse": true } } }
      },
      "credentials": { "supabaseApi": { "id": "supabase-account", "name": "Supabase account" } }
    },
    {
      "id": "find_patient_by_phone",
      "name": "Find Patient By Phone",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-720, 120],
      "parameters": {
        "method": "GET",
        "url": "https://lngkdzbhhxlnxweottie.supabase.co/rest/v1/patients",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "organization_id", "value": "=eq.{{ $json.organization_id }}" },
            { "name": "phone", "value": "=eq.{{ $json.phone }}" },
            { "name": "select", "value": "id" },
            { "name": "limit", "value": "1" }
          ]
        },
        "options": { "response": { "response": { "fullResponse": true } } }
      },
      "credentials": { "supabaseApi": { "id": "supabase-account", "name": "Supabase account" } }
    },
    {
      "id": "check_patient_match",
      "name": "Check Patient Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-500, 120],
      "parameters": {
        "jsCode": "const body = $json.body ?? [];\nconst matches = Array.isArray(body) ? body : [];\nconst prior = $('Validate & Normalize').item.json;\nreturn [{ json: { ...prior, patient_id: matches[0]?.id ?? null, patient_found: Boolean(matches[0]) } }];"
      }
    },
    {
      "id": "patient_found",
      "name": "Patient Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-280, 120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.patient_found }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "respond_no_patient",
      "name": "Respond: No Patient",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [-60, 320],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'No patient was found for that phone number.' } }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "get_upcoming_by_patient",
      "name": "Get Upcoming Appointments By Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-60, 40],
      "parameters": {
        "method": "GET",
        "url": "https://lngkdzbhhxlnxweottie.supabase.co/rest/v1/appointments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "organization_id", "value": "=eq.{{ $json.organization_id }}" },
            { "name": "patient_id", "value": "=eq.{{ $json.patient_id }}" },
            { "name": "status", "value": "=in.(requested,confirmed)" },
            { "name": "starts_at", "value": "=gte.{{ $now.toISO() }}" },
            { "name": "order", "value": "starts_at.asc" },
            { "name": "select", "value": "*" },
            { "name": "limit", "value": "5" }
          ]
        },
        "options": { "response": { "response": { "fullResponse": true } } }
      },
      "credentials": { "supabaseApi": { "id": "supabase-account", "name": "Supabase account" } }
    },
    {
      "id": "resolve_appointment",
      "name": "Resolve Appointment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, -60],
      "parameters": {
        "jsCode": "const body = $json.body ?? [];\nconst matches = Array.isArray(body) ? body : [];\nconst prior = $('Validate & Normalize').item.json;\nlet chosen = matches[0] ?? null;\nif (matches.length > 1 && prior.date) {\n  const wanted = prior.date;\n  chosen = matches.find((m) => String(m.starts_at).slice(0, 10) === wanted) || matches[0];\n}\nreturn [{ json: { ...prior, found: Boolean(chosen), appointment: chosen } }];"
      }
    },
    {
      "id": "appointment_found",
      "name": "Appointment Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [380, -60],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.found }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "respond_no_appointment",
      "name": "Respond: No Appointment",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'No upcoming appointment was found to cancel.' } }}",
        "options": { "responseCode": 200 }
      }
    },
