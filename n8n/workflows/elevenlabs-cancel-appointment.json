        "url": "=https://www.googleapis.com/calendar/v3/calendars/{{ encodeURIComponent($json.calendar_id) }}/events/{{ encodeURIComponent($json.appointment.calendar_event_id) }}",
        "authentication": "predefinedCredentialType",
