    {
      "id": "match_chunks",
      "name": "Match Chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://lngkdzbhhxlnxweottie.supabase.co/rest/v1/rpc/match_document_chunks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query_embedding: $json.query_embedding, match_count: 5, filter_organization_id: $json.organization_id }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "supabase-account",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "prepare_answer",
      "name": "Prepare Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        -120
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst rows = Array.isArray(body) ? body : [];\nconst hits = rows.map((row) => ({\n  id: row.id,\n  document_id: row.document_id,\n  file_name: row.file_name,\n  category: row.category,\n  content: String(row.content || ''),\n  chunk_index: row.chunk_index,\n  similarity: Number(row.similarity)\n})).filter((hit) => hit.content && hit.similarity >= 0.3).slice(0, 4);\nif (!hits.length) return [{ json: { _ready: false } }];\nconst question = $('Validate Request').first().json.query;\nconst passages = hits.map((hit, index) => '[' + (index + 1) + '] ' + hit.file_name + '\\n' + hit.content).join('\\n\\n');\nconst system = 'You answer staff questions for Maple Grove Dental Clinic. Use only the numbered passages. Do not add facts, fees, times, names, phone numbers, or advice that are not written there. Copy numbers, times, and names exactly. Give one direct answer in one or two sentences. Do not list related topics. Set passage to the number of the single passage you used. If none of the passages answer the question, set answer to \"The clinic documents do not say.\" and passage to 0. Reply with JSON only: {\"answer\":\"...\",\"passage\":1}';\nreturn [{ json: { _ready: true, hits, system_prompt: system, user_prompt: 'Question: ' + question + '\\n\\nPassages:\\n' + passages } }];"
      }
    },
    {
      "id": "answer_ready",
      "name": "Answer Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        760,
        -120
