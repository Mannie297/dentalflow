        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "write_answer",
      "name": "Write Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        -220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: $json.system_prompt }, { role: 'user', content: $json.user_prompt } ] }) }}",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "read_answer",
      "name": "Read Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -220
      ],
      "parameters": {
        "jsCode": "const prepared = $('Prepare Answer').first().json;\nconst hits = prepared.hits || [];\nconst raw = $json.choices && $json.choices[0] && $json.choices[0].message && $json.choices[0].message.content;\nlet parsed = null;\ntry { parsed = JSON.parse(raw || ''); } catch (error) { parsed = null; }\nconst answer = parsed && typeof parsed.answer === 'string' ? parsed.answer.trim() : '';\nconst passage = parsed ? Number(parsed.passage) : NaN;\nconst missing = 'The clinic documents do not say.';\nif (!answer || answer === missing || passage === 0) return [{ json: { answer: missing, hits: [] } }];\nconst hit = hits[passage - 1];\nif (!hit) return [{ json: { answer: hits[0] ? hits[0].content : missing, hits: hits[0] ? [hits[0]] : [] } }];\nfunction digits(value) { return String(value).replace(/\\D/g, ''); }\nfunction phones(text) { return (String(text).match(/\\(?\\d{3}\\)?[\\s.-]*\\d{3}[\\s.-]*\\d{4}/g) || []).map(digits); }\nfunction facts(text) { return String(text).match(/\\$\\d+(?:\\.\\d+)?|\\b\\d{1,2}:\\d{2}\\b|\\b\\d+\\s*hours?\\b/gi) || []; }\nconst source = hit.content;\nconst phoneMismatch = phones(answer).some((phone) => phone && !phones(source).includes(phone));\nconst factMismatch = facts(answer).some((fact) => !source.toLowerCase().includes(String(fact).toLowerCase()));\nif (phoneMismatch || factMismatch) return [{ json: { answer: source, hits: [hit] } }];\nreturn [{ json: { answer, hits: [hit] } }];"
      }
    },
    {
      "id": "respond_answer",
      "name": "Respond: Answer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1420,
        -220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, answer: $json.answer, hits: $json.hits } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
