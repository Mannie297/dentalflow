    {
      "id": "embed_question",
      "name": "Embed Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -340,
        -40
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'text-embedding-3-small', input: $json.query }) }}",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "prepare_search",
      "name": "Prepare Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        -40
      ],
      "parameters": {
        "jsCode": "const embedding = $json.data && $json.data[0] && $json.data[0].embedding;\nif (!Array.isArray(embedding) || embedding.length !== 1536) {\n  return [{ json: { _ok: false, _error: 'The embedding service did not return a search vector.' } }];\n}\nconst request = $('Validate Request').first().json;\nreturn [{ json: { _ok: true, query_embedding: '[' + embedding.join(',') + ']', organization_id: request.organization_id } }];"
      }
    },
    {
      "id": "vector_ready",
      "name": "Vector Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        100,
        -40
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json._ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "respond_embed_failed",
