{
  "name": "Knowledge — Search",
  "meta": {
    "description": "Embeds a clinic question, finds the closest passages in Supabase, and writes one answer from those passages. Fees, times, and names must come from the document."
  },
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook: Knowledge Search",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1000,
        0
      ],
      "parameters": {
        "path": "knowledge-search",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -780,
        0
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst query = String(body.query || '').trim();\nconst organizationId = String(body.organization_id || '');\nconst errors = [];\nif (query.length < 3) errors.push('Enter at least 3 characters to search.');\nif (query.length > 500) errors.push('Enter a shorter question.');\nif (!uuid.test(organizationId)) errors.push('organization_id is required.');\nreturn [{ json: { query, organization_id: organizationId, _valid: errors.length === 0, _errors: errors } }];"
      }
    },
    {
      "id": "validation_passed",
      "name": "Validation Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -560,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json._valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
